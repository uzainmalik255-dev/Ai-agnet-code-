import os
import sys
import time
from google import genai
from google.genai import errors

API_KEY = os.getenv("GEMINI_API_KEY", "")
MODEL_NAME = "gemini-2.5-flash"

try:
    client = genai.Client(api_key=API_KEY)
    chat = client.chats.create(model=MODEL_NAME)
except Exception as e:
    print("=" * 50)
    print("  ERROR: Could not connect to Gemini")
    print("=" * 50)
    print(f"  {e}")
    sys.exit(1)

print("=" * 50)
print("   Gemini Chatbot - Connected Successfully!")
print("=" * 50)
print(f"   Model: {MODEL_NAME}")
print("   Commands:")
print("     exit / quit / bye  -> Stop chatting")
print("     clear              -> Reset conversation")
print("=" * 50)
print()

msg_count = 0

while True:
    try:
        user_input = input("You: ").strip()

        if not user_input:
            continue

        if user_input.lower() in ["exit", "quit", "bye", "stop"]:
            print("\nBot: Goodbye! Have a great day!")
            break

        if user_input.lower() == "clear":
            chat = client.chats.create(model=MODEL_NAME)
            print("\nBot: Conversation history cleared!\n")
            continue

        print("Bot: ", end="", flush=True)

        response = None
        for attempt in range(5):
            try:
                response = chat.send_message(user_input)
                break
            except errors.APIError as e:
                if e.code in [429, 503]:
                    wait = (attempt + 1) * 3
                    print(f"\n[Server busy. Retrying in {wait}s...]", end=" ", flush=True)
                    time.sleep(wait)
                    continue
                print(f"\n[API Error: {e.message}]")
                break
            except Exception as e:
                print(f"\n[Network Error: {e}]")
                break

        if response and hasattr(response, "text"):
            print(response.text)
            print()
            msg_count += 1
            
        time.sleep(1.5)

    except KeyboardInterrupt:
        print("\n\nBot: Chat closed.")
        break
    except Exception as e:
        print(f"\n[Unexpected error: {e}]\n")
        continue
